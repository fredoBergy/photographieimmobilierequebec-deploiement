# Funio/Apache: keep uploads private from directory listings; use verified HTTPS.
Options -Indexes
DirectoryIndex index.html

# Compress text assets to improve Core Web Vitals and mobile loading time.
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Cache versioned static assets; HTML remains short-lived so updates propagate.
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 5 minutes"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType video/mp4 "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
<FilesMatch "\.(?:css|js|jpg|jpeg|png|webp|svg|woff2|mp4)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>

# Only the new contact endpoint uses this runtime; other sites are untouched.
<Files "contact-send.php">
SetHandler application/x-httpd-alt-php84___lsphp
</Files>
<Files "error_log">
Require all denied
</Files>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.photographie-immobiliere-quebec\.com$ [NC]
RewriteRule ^ https://photographie-immobiliere-quebec.com%{REQUEST_URI} [R=301,L]

# Preserve the old Wix page addresses on the existing custom domain.
RewriteRule ^a-propos/?$ /a-propos.html [R=301,L]
RewriteRule ^services-offerts/?$ /services.html [R=301,L]
RewriteRule ^services/?$ /services.html [R=301,L]
RewriteRule ^general-5-1/?$ /tarifs.html [R=301,L]
RewriteRule ^contact/?$ /contact.html [R=301,L]
RewriteRule ^photos-videos-aeriennes-par-drone/?$ /drone.html [R=301,L]
RewriteRule ^photographies-immobilieres-hotels-maisons-condo/?$ /photographie-immobiliere.html [R=301,L]
RewriteRule ^visite-virtuelle-360/?$ /visite-360.html [R=301,L]
RewriteRule ^montages-videos/?$ /montage-video.html [R=301,L]
RewriteRule ^copie-de-photographie-corporatives/?$ /corporatif.html [R=301,L]
</IfModule>
